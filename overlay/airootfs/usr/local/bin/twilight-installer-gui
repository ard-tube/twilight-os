        layout.addWidget(driver_box)

        extras_box = QGroupBox("Extras")
        extras_layout = QVBoxLayout(extras_box)

        self.chk_flatpak = QCheckBox("Enable Flatpak & Flathub  (for Spotify, Heroic, Joplin)")
        self.chk_flatpak.setChecked(True)
        extras_layout.addWidget(self.chk_flatpak)

        self.chk_multilib = QCheckBox("Enable multilib repository  (32-bit compatibility, required for Steam/Wine)")
        self.chk_multilib.setChecked(True)
        extras_layout.addWidget(self.chk_multilib)

        layout.addWidget(extras_box)

        note = QLabel(
            "<p style='color: #a6adc8; font-style: italic; font-size: 12px;'>"
            "💡 If unsure about your GPU, keep AMD & Intel checked — they use open-source "
            "drivers and work universally. Check NVIDIA only if you have an NVIDIA card.</p>"
        )
        note.setWordWrap(True)
        layout.addWidget(note)

        layout.addStretch()
        self.tabs.addTab(tab, "6. Drivers")

    def _detect_gpu(self) -> str:
        """Try to detect GPU hardware."""
        try:
            output = subprocess.check_output(
                ["lspci", "-nn"], text=True, timeout=10, stderr=subprocess.DEVNULL
            )
            gpus = []
            for line in output.split("\n"):
                if "VGA" in line or "3D" in line or "Display" in line:
                    # Extract the description part
                    parts = line.split(": ", 1)
                    if len(parts) > 1:
                        gpus.append(parts[1].strip())
            return " | ".join(gpus) if gpus else ""
        except Exception:
            return ""

    # ── Tab 7: Install ──────────────────────────────────────────────────────

    def _setup_install_tab(self):
        tab = QWidget()
        layout = QVBoxLayout(tab)

        layout.addWidget(QLabel(
            "<h2 style='color: #cba6f7;'>Review & Install</h2>"
            "<p>Review your choices below, then click Install to begin.</p>"
        ))

        # Summary text area
        self.summary_text = QTextEdit()
        self.summary_text.setReadOnly(True)
        self.summary_text.setMaximumHeight(220)
        layout.addWidget(self.summary_text)

        btn_refresh_summary = QPushButton("🔄 Refresh Summary")
        btn_refresh_summary.setObjectName("secondaryBtn")
        btn_refresh_summary.clicked.connect(self._update_summary)
        layout.addWidget(btn_refresh_summary)

        # Progress
        self.progress = QProgressBar()
        self.progress.setValue(0)
        self.progress.setVisible(False)
        layout.addWidget(self.progress)

        self.status_lbl = QLabel("")
        self.status_lbl.setStyleSheet("color: #a6adc8; font-style: italic;")
        self.status_lbl.setWordWrap(True)
        layout.addWidget(self.status_lbl)

        layout.addStretch()

        btn_row = QHBoxLayout()
        btn_row.addStretch()

        self.btn_install = QPushButton("🚀 Install Twilight OS")
        self.btn_install.setObjectName("installBtn")
        self.btn_install.clicked.connect(self._start_installation)
        btn_row.addWidget(self.btn_install)

        btn_row.addStretch()
        layout.addLayout(btn_row)

        layout.addStretch()
        self.tabs.addTab(tab, "7. Install")

        # Populate summary on first view
        self.tabs.currentChanged.connect(
            lambda i: self._update_summary() if i == self.tabs.count() - 1 else None
        )

    def _update_summary(self):
        """Build a human-readable summary of all installation choices."""
        selected_pkgs = [pkg for pkg, chk in self.checkboxes.items() if chk.isChecked()]
        drivers = []
        if self.chk_nvidia.isChecked():
            drivers.append("NVIDIA")
        if self.chk_amd.isChecked():
            drivers.append("AMD")
        if self.chk_intel.isChecked():
            drivers.append("Intel")

        summary = textwrap.dedent(f"""\
            ╔══════════════════════════════════════════════════╗
            ║         Twilight OS Installation Summary         ║
            ╚══════════════════════════════════════════════════╝

            Locale:     {self.combo_locale.currentData() or 'en_US.UTF-8'}
            Timezone:   {self.combo_timezone.currentData() or 'UTC'}
            Keyboard:   {self.combo_keyboard.currentData() or 'us'}

            Target:     {self.disk_combo.currentData() or '(none selected)'}

            Full Name:  {self.input_realname.text().strip() or '(not set)'}
            Username:   {self.input_username.text().strip() or '(not set)'}
            Hostname:   {self.input_hostname.text().strip() or '(not set)'}
            Sudo:       {'Yes' if self.chk_wheel.isChecked() else 'No'}

            Packages:   {len(selected_pkgs)} selected
            Drivers:    {', '.join(drivers) or 'None'}
            Flatpak:    {'Yes' if self.chk_flatpak.isChecked() else 'No'}
            Multilib:   {'Yes' if self.chk_multilib.isChecked() else 'No'}

            ─────────────────────────────────────────────────
            Selected Packages:
            {chr(10).join(f'  • {p}' for p in selected_pkgs) or '  (none)'}
        """)
        self.summary_text.setText(summary)

    def _build_config(self) -> dict:
        """Collect all user choices into a config dict."""
        selected_pkgs = [pkg for pkg, chk in self.checkboxes.items() if chk.isChecked()]
        drivers = []
        if self.chk_nvidia.isChecked():
            drivers.append("nvidia")
        if self.chk_amd.isChecked():
            drivers.append("amd")
        if self.chk_intel.isChecked():
            drivers.append("intel")

        return {
            "version": VERSION,
            "locale": self.combo_locale.currentData() or "en_US.UTF-8",
            "timezone": self.combo_timezone.currentData() or "UTC",
            "keyboard": self.combo_keyboard.currentData() or "us",
            "disk": self.disk_combo.currentData() or "",
            "realname": self.input_realname.text().strip(),
            "username": self.input_username.text().strip(),
            "hostname": self.input_hostname.text().strip(),
            "password": self.input_password.text(),
            "sudo": self.chk_wheel.isChecked(),
            "root_same_password": self.chk_root_same.isChecked(),
            "packages": selected_pkgs,
            "drivers": drivers,
            "flatpak": self.chk_flatpak.isChecked(),
            "multilib": self.chk_multilib.isChecked(),
        }

    def _validate_all(self) -> list:
        """Full validation of all user inputs."""
        errors = []

        # Username
        username = self.input_username.text().strip()
        if not username:
            errors.append("Username is required.")
        elif not USERNAME_RE.match(username):
            errors.append("Username must start with a letter or underscore, "
                          "and contain only lowercase a-z, 0-9, dash, or underscore.")

        # Hostname
        hostname = self.input_hostname.text().strip()
        if not hostname:
            errors.append("Hostname is required.")
        elif not HOSTNAME_RE.match(hostname):
            errors.append("Hostname must be 1-63 characters, letters/numbers/hyphens only, "
                          "cannot start or end with a hyphen.")

        # Password
        pw = self.input_password.text()
        confirm = self.input_password_confirm.text()
        if not pw:
            errors.append("Password is required.")
        elif len(pw) < 4:
            errors.append("Password must be at least 4 characters.")
        elif pw != confirm:
            errors.append("Passwords do not match.")

        # Disk
        disk = self.disk_combo.currentData()
        if not disk:
            errors.append("No target disk selected.")

        return errors

    def _start_installation(self):
        errors = self._validate_all()
        if errors:
            QMessageBox.warning(
                self, "Cannot Proceed",
                "Please fix the following issues before installing:\n\n• "
                + "\n• ".join(errors)
            )
            return

        config = self._build_config()

        reply = QMessageBox.warning(
            self,
            "⚠️ Confirm Installation",
            f"You are about to install Twilight OS.\n\n"
            f"Target Disk: {config['disk']}\n"
            f"Username: {config['username']}\n"
            f"Hostname: {config['hostname']}\n"
            f"Packages: {len(config['packages'])} apps + "
            f"{', '.join(d.upper() for d in config['drivers']) or 'no'} drivers\n\n"
            "⚠️ ALL DATA ON THE TARGET DISK WILL BE PERMANENTLY ERASED.\n\n"
            "Are you absolutely sure you want to continue?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No
        )

        if reply != QMessageBox.StandardButton.Yes:
            return

        # Disable UI during installation
        self.btn_install.setEnabled(False)
        self.btn_next.setEnabled(False)
        self.btn_back.setEnabled(False)
        self.progress.setVisible(True)
        self.progress.setRange(0, 0)  # Pulsing
        self.status_lbl.setText("Preparing installation...")

        # Start worker thread
        self.worker = InstallWorker(config)
        self.worker.progress.connect(self._on_install_progress)
        self.worker.log_output.connect(self._on_install_log)
        self.worker.finished_ok.connect(self._on_install_success)
        self.worker.finished_err.connect(self._on_install_error)
        self.worker.start()

    def _on_install_progress(self, msg):
        self.status_lbl.setText(msg)

    def _on_install_log(self, line):
        self.summary_text.append(line)

    def _on_install_success(self):
        self.progress.setRange(0, 100)
        self.progress.setValue(100)
        self.status_lbl.setText("Configuration saved! Launching archinstall...")

        # Launch archinstall in a terminal emulator
        terminal = shutil.which("konsole") or shutil.which("xterm")
        config = self._build_config()
        target_disk = config.get("disk", "")
        finalize_bin = "/usr/local/bin/twilight-finalize-install"

        if terminal:
            install_cmd = (
                "echo '╔════════════════════════════════════════════════════════════╗'; "
                "echo '║           🌌 Twilight OS Guided Installation               ║'; "
                "echo '╚════════════════════════════════════════════════════════════╝'; echo ''; "
                "echo 'Step 1/2: Running Arch Linux guided installer (archinstall)...'; echo ''; "
                "archinstall; "
                "echo ''; echo 'Step 2/2: Finalizing Twilight OS customizations...'; "
                f"if [ -x {finalize_bin} ]; then "
                f"  sudo {finalize_bin} '{target_disk}'; "
                "fi; "
                "echo ''; echo '════════════════════════════════════════════════════'; "
                "echo '  🎉 Twilight OS installation is complete!'; "
                "echo '  You can now close this window and restart your PC.'; "
                "echo '════════════════════════════════════════════════════'; "
                "echo 'Press Enter to exit...'; read"
            )
            try:
                subprocess.Popen([terminal, "-e", "bash", "-c", install_cmd])
                self.status_lbl.setText(
                    "✅ Installer terminal launched. Follow the on-screen prompts.\n"
                    "Twilight OS branding, desktop settings, and all selected packages\n"
                    "will be automatically finalized upon completion."
                )
            except Exception as e:
                self._on_install_error(f"Failed to launch terminal: {e}")
        else:
            self._on_install_error("No terminal emulator (konsole or xterm) found.")

    def _on_install_error(self, error):
        self.progress.setVisible(False)
        self.btn_install.setEnabled(True)
        self.btn_next.setEnabled(True)
        self.btn_back.setEnabled(True)
        self.status_lbl.setStyleSheet("color: #f38ba8; font-style: italic;")
        self.status_lbl.setText(f"❌ Error: {error}")
        QMessageBox.critical(self, "Installation Error", f"An error occurred:\n\n{error}")


# ──────────────────────────────────────────────────────────────────────────────
# Entry Point
# ──────────────────────────────────────────────────────────────────────────────

def main():
    # Check if we're running as root (needed for installation)
    if os.geteuid() != 0:
        # Try to re-launch with sudo
        print("Twilight OS Setup Assistant requires root privileges.")
        print("Attempting to re-launch with sudo...")
        try:
            os.execvp("sudo", ["sudo", sys.executable] + sys.argv)
        except Exception:
            print("Failed to elevate privileges. Please run with: sudo twilight-installer-gui")
            sys.exit(1)

    app = QApplication(sys.argv)
    app.setApplicationName("Twilight OS Setup Assistant")
    app.setApplicationVersion(VERSION)

    window = InstallerWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
