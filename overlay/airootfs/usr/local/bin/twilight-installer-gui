# ──────────────────────────────────────────────────────────────────────────────
# Worker Thread for Installation
# ──────────────────────────────────────────────────────────────────────────────

class InstallWorker(QThread):
    """Background thread that runs the installation process."""
    progress = pyqtSignal(str)       # status message
    log_output = pyqtSignal(str)     # terminal output line
    finished_ok = pyqtSignal()       # installation succeeded
    finished_err = pyqtSignal(str)   # installation failed with error

    def __init__(self, config: dict, parent=None):
        super().__init__(parent)
        self.config = config

    def run(self):
        try:
            # Step 1: Write config to disk
            self.progress.emit("Writing installation configuration...")
            conf_path = Path(INSTALL_CONF)
            conf_path.write_text(json.dumps(self.config, indent=2), encoding="utf-8")

            # Step 2: Launch archinstall with the user config
            self.progress.emit("Starting archinstall guided installer...")
            self.log_output.emit("═" * 60)
            self.log_output.emit("  Twilight OS Installation")
            self.log_output.emit("═" * 60)
            self.log_output.emit(f"Target disk: {self.config.get('disk', 'N/A')}")
            self.log_output.emit(f"Username: {self.config.get('username', 'N/A')}")
            self.log_output.emit(f"Hostname: {self.config.get('hostname', 'N/A')}")
            self.log_output.emit(f"Locale: {self.config.get('locale', 'N/A')}")
            self.log_output.emit(f"Timezone: {self.config.get('timezone', 'N/A')}")
            self.log_output.emit(f"Packages: {len(self.config.get('packages', []))} selected")
            self.log_output.emit(f"Drivers: {', '.join(self.config.get('drivers', [])) or 'None'}")
            self.log_output.emit("")
            self.log_output.emit("Launching archinstall...")
            self.log_output.emit("Follow the prompts in the terminal window.")
            self.log_output.emit("")

            # Write the post-install script that will be run inside the chroot
            post_script = self._generate_post_install_script()
            post_path = Path("/tmp/twilight-post-install.sh")
            post_path.write_text(post_script, encoding="utf-8")
            post_path.chmod(0o755)

            self.progress.emit("Installation configuration saved. Launching archinstall...")
            self.finished_ok.emit()

        except Exception as e:
            self.finished_err.emit(str(e))

    def _generate_post_install_script(self) -> str:
        """Generate a bash script that applies Twilight OS customizations
        after archinstall completes."""
        packages = self.config.get("packages", [])
        drivers = self.config.get("drivers", [])
        driver_pkgs = []
        for d in drivers:
            driver_pkgs.extend(DRIVER_PACKAGES.get(d, []))
        all_pkgs = packages + driver_pkgs
        pkg_str = " ".join(all_pkgs) if all_pkgs else ""

        locale = self.config.get("locale", "en_US.UTF-8")
        timezone = self.config.get("timezone", "UTC")
        hostname = self.config.get("hostname", "twilight-pc")
        keyboard = self.config.get("keyboard", "us")
        enable_flatpak = self.config.get("flatpak", True)

        script = textwrap.dedent(f"""\
            #!/usr/bin/env bash
            # Twilight OS Post-Install Script
            # Auto-generated by Twilight OS Setup Assistant v{VERSION}
            set -euo pipefail

            echo "════════════════════════════════════════════════════"
            echo "  Twilight OS Post-Installation Setup"
            echo "════════════════════════════════════════════════════"
            echo ""

            # Locale
            echo "→ Setting locale to {locale}..."
            sed -i 's/^#\\?{locale}/{locale}/' /etc/locale.gen 2>/dev/null || true
            echo "LANG={locale}" > /etc/locale.conf
            locale-gen

            # Timezone
            echo "→ Setting timezone to {timezone}..."
            ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime
            hwclock --systohc

            # Hostname
            echo "→ Setting hostname to {hostname}..."
            echo "{hostname}" > /etc/hostname
            cat > /etc/hosts << 'HOSTS'
            127.0.0.1   localhost
            ::1         localhost
            127.0.1.1   {hostname}.localdomain {hostname}
            HOSTS

            # Keyboard
            echo "→ Setting keyboard layout to {keyboard}..."
            echo "KEYMAP={keyboard}" > /etc/vconsole.conf

            # Install selected packages
            if [ -n "{pkg_str}" ]; then
                echo ""
                echo "→ Installing {len(all_pkgs)} selected packages..."
                pacman -S --noconfirm --needed {pkg_str} || echo "Warning: Some packages may have failed to install."
            fi

            # Flatpak
            {"" if not enable_flatpak else '''
            echo ""
            echo "→ Enabling Flatpak & Flathub..."
            pacman -S --noconfirm --needed flatpak || true
            flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
            '''}

            # Apply Twilight OS branding
            if [[ -x /usr/local/bin/apply-twilight-branding ]]; then
                echo ""
                echo "→ Applying Twilight OS branding..."
                /usr/local/bin/apply-twilight-branding
            fi

            echo ""
            echo "════════════════════════════════════════════════════"
            echo "  ✅ Twilight OS post-install setup complete!"
            echo "════════════════════════════════════════════════════"
            echo ""
        """)
        return script


# ──────────────────────────────────────────────────────────────────────────────
# Main Window
# ──────────────────────────────────────────────────────────────────────────────

class InstallerWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(f"Twilight OS Setup Assistant v{VERSION}")
        self.resize(900, 720)
        self.setMinimumSize(700, 550)
        self.setStyleSheet(TWILIGHT_STYLESHEET)

        self.checkboxes = {}
        self.worker = None

        central_widget = QWidget()
        self.setCentralWidget(central_widget)
        main_layout = QVBoxLayout(central_widget)
        main_layout.setContentsMargins(16, 12, 16, 12)
        main_layout.setSpacing(8)

        # ── Header ──
        header = QFrame()
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(4, 0, 4, 8)

        title_label = QLabel("🌌 Twilight OS Setup Assistant")
        title_font = QFont()
        title_font.setPointSize(18)
        title_font.setBold(True)
        title_label.setFont(title_font)
        title_label.setStyleSheet("color: #cba6f7;")
        header_layout.addWidget(title_label)

        version_label = QLabel(f"v{VERSION} • KDE Plasma 6 • Rolling Release")
        version_label.setStyleSheet("color: #89b4fa; font-style: italic; font-size: 12px;")
        version_label.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        header_layout.addWidget(version_label)

        main_layout.addWidget(header)

        # ── Tabs ──
        self.tabs = QTabWidget()
        self.tabs.currentChanged.connect(self._on_tab_changed)
        main_layout.addWidget(self.tabs)

        self._setup_welcome_tab()
        self._setup_locale_tab()
        self._setup_disk_tab()
        self._setup_user_tab()
        self._setup_software_tab()
        self._setup_drivers_tab()
        self._setup_install_tab()

        # ── Bottom Navigation ──
        nav_layout = QHBoxLayout()
        nav_layout.setContentsMargins(0, 8, 0, 0)

        self.btn_back = QPushButton("◀ Back")
        self.btn_back.setObjectName("secondaryBtn")
        self.btn_back.clicked.connect(self._prev_tab)
        nav_layout.addWidget(self.btn_back)

        nav_layout.addStretch()

        self.nav_status = QLabel("")
        self.nav_status.setStyleSheet("color: #585b70; font-size: 12px;")
        nav_layout.addWidget(self.nav_status)

        nav_layout.addStretch()

        self.btn_next = QPushButton("Next ▶")
        self.btn_next.clicked.connect(self._next_tab)
        nav_layout.addWidget(self.btn_next)

        main_layout.addLayout(nav_layout)
        self._update_nav()

    # ── Navigation ──────────────────────────────────────────────────────────

    def _on_tab_changed(self, _index):
        self._update_nav()

    def _update_nav(self):
        idx = self.tabs.currentIndex()
        total = self.tabs.count()
        self.btn_back.setEnabled(idx > 0)
        self.btn_next.setEnabled(idx < total - 1)
        self.nav_status.setText(f"Step {idx + 1} of {total}")

    def _next_tab(self):
        self.tabs.setCurrentIndex(self.tabs.currentIndex() + 1)

    def _prev_tab(self):
        self.tabs.setCurrentIndex(self.tabs.currentIndex() - 1)

    # ── Tab 1: Welcome ──────────────────────────────────────────────────────

    def _setup_welcome_tab(self):
        tab = QWidget()
        layout = QVBoxLayout(tab)
        layout.setSpacing(14)

        intro = QLabel(
            "<h2 style='color: #cba6f7;'>Welcome to Twilight OS!</h2>"
            "<p style='font-size: 14px;'>Twilight OS is a modern, daily-driver operating system "
            "powered by <b>Arch Linux</b> and the <b>KDE Plasma 6</b> desktop on Wayland.</p>"
            "<p style='font-size: 14px;'>This Setup Assistant will guide you through:</p>"
            "<ul style='font-size: 14px;'>"
            "<li>Locale, timezone & keyboard configuration</li>"
            "<li>Disk selection & partitioning</li>"
            "<li>User account creation</li>"
            "<li>Software suite selection (50 curated apps)</li>"
            "<li>GPU driver installation</li>"
            "</ul>"
        )
        intro.setWordWrap(True)
        layout.addWidget(intro)

        info_box = QGroupBox("Live Environment Info")
        info_layout = QGridLayout(info_box)
        info_layout.setSpacing(8)

        try:
            kernel = os.uname().release
        except (AttributeError, OSError):
            kernel = "unknown"

        info_items = [
            ("Kernel", f"Linux {kernel}"),
            ("Desktop", "KDE Plasma 6 (Wayland)"),
            ("Live User", "liveuser (passwordless sudo)"),
            ("Installer", f"v{VERSION}"),
        ]
        for row, (key, val) in enumerate(info_items):
            info_layout.addWidget(QLabel(f"<b>{key}:</b>"), row, 0)
            info_layout.addWidget(QLabel(val), row, 1)

        layout.addWidget(info_box)
        layout.addStretch()
        self.tabs.addTab(tab, "1. Welcome")

    # ── Tab 2: Locale & Timezone ────────────────────────────────────────────

    def _setup_locale_tab(self):
        tab = QWidget()
        layout = QVBoxLayout(tab)
        layout.setSpacing(12)

        layout.addWidget(QLabel("<h3>Locale, Timezone & Keyboard</h3>"))

        grid = QGridLayout()
        grid.setSpacing(12)

        # Locale
        grid.addWidget(QLabel("System Locale:"), 0, 0)
        self.combo_locale = QComboBox()
        for code, name in LOCALES:
            self.combo_locale.addItem(f"{name}  [{code}]", code)
        self.combo_locale.setCurrentIndex(0)
        grid.addWidget(self.combo_locale, 0, 1)

        # Timezone
        grid.addWidget(QLabel("Timezone:"), 1, 0)
        self.combo_timezone = QComboBox()
        for region, zones in TIMEZONES.items():
            for tz in zones:
                self.combo_timezone.addItem(tz, tz)
        # Try to auto-detect timezone
        self._autodetect_timezone()
        grid.addWidget(self.combo_timezone, 1, 1)

        # Keyboard layout
        grid.addWidget(QLabel("Keyboard Layout:"), 2, 0)
        self.combo_keyboard = QComboBox()
        for code, name in KEYBOARD_LAYOUTS:
            self.combo_keyboard.addItem(f"{name}  [{code}]", code)
        self.combo_keyboard.setCurrentIndex(0)
        grid.addWidget(self.combo_keyboard, 2, 1)

        layout.addLayout(grid)

        hint = QLabel(
            "<p style='color: #a6adc8; font-size: 12px;'>"
            "💡 The installer will auto-detect your timezone when possible. "
            "You can override it manually above.</p>"
        )
        hint.setWordWrap(True)
        layout.addWidget(hint)

        layout.addStretch()
        self.tabs.addTab(tab, "2. Locale")

    def _autodetect_timezone(self):
        """Try to detect the current timezone."""
        try:
            tz_link = os.readlink("/etc/localtime")
            if "/zoneinfo/" in tz_link:
                tz = tz_link.split("/zoneinfo/", 1)[1]
                idx = self.combo_timezone.findData(tz)
                if idx >= 0:
                    self.combo_timezone.setCurrentIndex(idx)
                    return
        except (OSError, IndexError):
            pass

    # ── Tab 3: Disk ─────────────────────────────────────────────────────────

    def _setup_disk_tab(self):
        tab = QWidget()
        layout = QVBoxLayout(tab)

        layout.addWidget(QLabel(
            "<h3>Storage & Partitioning</h3>"
            "<p>Select the target drive for Twilight OS installation:</p>"
        ))

        self.disk_combo = QComboBox()
        self._populate_disks()
        layout.addWidget(self.disk_combo)

        btn_row = QHBoxLayout()
        btn_refresh = QPushButton("🔄 Refresh")
        btn_refresh.setObjectName("secondaryBtn")
        btn_refresh.clicked.connect(self._populate_disks)
        btn_row.addWidget(btn_refresh)

        btn_partitioner = QPushButton("🔧 Partition Manager")
        btn_partitioner.setObjectName("secondaryBtn")
        btn_partitioner.clicked.connect(self._launch_partitioner)
        btn_row.addWidget(btn_partitioner)

        btn_row.addStretch()
        layout.addLayout(btn_row)

        # Disk details
        self.disk_details = QLabel("")
        self.disk_details.setWordWrap(True)
        self.disk_details.setStyleSheet("color: #a6adc8; font-size: 12px; padding: 8px;")
        layout.addWidget(self.disk_details)
        self.disk_combo.currentIndexChanged.connect(self._update_disk_details)

        warn = QLabel(
            "<p style='color: #f38ba8;'>"
            "⚠️ <b>Warning:</b> The selected drive will be completely erased during installation. "
            "Make sure you have backed up all important data!</p>"
        )
        warn.setWordWrap(True)
        layout.addWidget(warn)

        layout.addStretch()
        self.tabs.addTab(tab, "3. Storage")

    def _populate_disks(self):
        self.disk_combo.clear()
        try:
            output = subprocess.check_output(
                ["lsblk", "-d", "-n", "-o", "NAME,SIZE,MODEL,TYPE"],
                text=True, timeout=10, stderr=subprocess.DEVNULL
            )
            found = False
            for line in output.strip().split("\n"):
                if not line.strip():
                    continue
                parts = line.split()
                name = parts[0]
                if parts[-1] != "disk":
                    continue
                if name.startswith(("loop", "airoot", "sr", "ram", "zram")):
                    continue
                size = parts[1] if len(parts) > 1 else "?"
                model = " ".join(parts[2:-1]) if len(parts) > 3 else "Unknown"
                self.disk_combo.addItem(
                    f"/dev/{name}  •  {size}  •  {model}",
                    f"/dev/{name}"
                )
                found = True
            if not found:
                self.disk_combo.addItem("(No drives detected)", "")
        except Exception:
            self.disk_combo.addItem("(Error detecting drives)", "")
        self._update_disk_details()

    def _update_disk_details(self):
        disk = self.disk_combo.currentData()
        if not disk:
            self.disk_details.setText("")
            return
        try:
            output = subprocess.check_output(
                ["lsblk", "-n", "-o", "NAME,SIZE,FSTYPE,MOUNTPOINT", disk],
                text=True, timeout=10, stderr=subprocess.DEVNULL
            )
            self.disk_details.setText(f"<pre>{output.strip()}</pre>")
        except Exception:
            self.disk_details.setText("")

    def _launch_partitioner(self):
        for tool in ["partitionmanager", "gparted"]:
            if shutil.which(tool):
                try:
                    subprocess.Popen(["sudo", tool])
                except Exception as e:
                    QMessageBox.warning(self, "Error", f"Failed to launch {tool}: {e}")
                return
        QMessageBox.warning(
            self, "Partition Manager",
            "No partition manager found.\n\n"
            "Both 'partitionmanager' and 'gparted' are missing.\n"
            "Use 'sudo cfdisk /dev/sdX' in a terminal instead."
        )

    # ── Tab 4: User Account ─────────────────────────────────────────────────

    def _setup_user_tab(self):
        tab = QWidget()
        layout = QVBoxLayout(tab)

        layout.addWidget(QLabel("<h3>User & Machine Configuration</h3>"))

        grid = QGridLayout()
        grid.setSpacing(12)
        grid.setColumnStretch(1, 1)

        # Full name
        grid.addWidget(QLabel("Full Name:"), 0, 0)
        self.input_realname = QLineEdit()
        self.input_realname.setPlaceholderText("e.g. Arda")
        grid.addWidget(self.input_realname, 0, 1)

        # Username
        grid.addWidget(QLabel("Username:"), 1, 0)
        self.input_username = QLineEdit()
        self.input_username.setPlaceholderText("lowercase letters, numbers, dash, underscore")
        self.input_username.setMaxLength(32)
        grid.addWidget(self.input_username, 1, 1)

        self.username_hint = QLabel("")
        self.username_hint.setStyleSheet("font-size: 11px;")
        grid.addWidget(self.username_hint, 2, 1)
        self.input_username.textChanged.connect(self._validate_username_live)

        # Hostname
        grid.addWidget(QLabel("Hostname:"), 3, 0)
        self.input_hostname = QLineEdit()
        self.input_hostname.setPlaceholderText("e.g. twilight-pc")
        self.input_hostname.setMaxLength(63)
        grid.addWidget(self.input_hostname, 3, 1)

        # Password
        grid.addWidget(QLabel("Password:"), 4, 0)
        self.input_password = QLineEdit()
        self.input_password.setEchoMode(QLineEdit.EchoMode.Password)
        self.input_password.setPlaceholderText("Enter a strong password")
        grid.addWidget(self.input_password, 4, 1)

        # Confirm
        grid.addWidget(QLabel("Confirm Password:"), 5, 0)
        self.input_password_confirm = QLineEdit()
        self.input_password_confirm.setEchoMode(QLineEdit.EchoMode.Password)
        self.input_password_confirm.setPlaceholderText("Re-enter your password")
        grid.addWidget(self.input_password_confirm, 5, 1)

        self.password_hint = QLabel("")
        self.password_hint.setStyleSheet("font-size: 11px;")
        grid.addWidget(self.password_hint, 6, 1)
        self.input_password_confirm.textChanged.connect(self._validate_password_live)
        self.input_password.textChanged.connect(self._validate_password_live)

        # Sudo
        self.chk_wheel = QCheckBox("Grant sudo / administrator rights (wheel group)")
        self.chk_wheel.setChecked(True)
        grid.addWidget(self.chk_wheel, 7, 1)

        # Root password
        self.chk_root_same = QCheckBox("Use same password for root account")
        self.chk_root_same.setChecked(True)
        grid.addWidget(self.chk_root_same, 8, 1)

        layout.addLayout(grid)
        layout.addStretch()
        self.tabs.addTab(tab, "4. User")

    def _validate_username_live(self, text):
        text = text.strip()
        if not text:
            self.username_hint.setText("")
            return
        if USERNAME_RE.match(text):
            self.username_hint.setStyleSheet("color: #a6e3a1; font-size: 11px;")
            self.username_hint.setText("✓ Valid username")
        else:
            self.username_hint.setStyleSheet("color: #f38ba8; font-size: 11px;")
            self.username_hint.setText("✗ Must start with letter/underscore, only a-z 0-9 _ -")

    def _validate_password_live(self):
        pw = self.input_password.text()
        confirm = self.input_password_confirm.text()
        if not pw and not confirm:
            self.password_hint.setText("")
            return
        if pw and len(pw) < 4:
            self.password_hint.setStyleSheet("color: #fab387; font-size: 11px;")
            self.password_hint.setText("⚠ Password is very short")
        elif pw and confirm and pw != confirm:
            self.password_hint.setStyleSheet("color: #f38ba8; font-size: 11px;")
            self.password_hint.setText("✗ Passwords do not match")
        elif pw and confirm and pw == confirm:
            self.password_hint.setStyleSheet("color: #a6e3a1; font-size: 11px;")
            self.password_hint.setText("✓ Passwords match")
        else:
            self.password_hint.setText("")

    # ── Tab 5: Software ─────────────────────────────────────────────────────

    def _setup_software_tab(self):
        tab = QWidget()
        layout = QVBoxLayout(tab)

        header_row = QHBoxLayout()
        header_row.addWidget(QLabel(
            "<h3>Curated Software Suite</h3>"
        ))
        header_row.addStretch()

        self.pkg_count_label = QLabel("")
        self.pkg_count_label.setStyleSheet("color: #89b4fa; font-size: 12px;")
        header_row.addWidget(self.pkg_count_label)
        layout.addLayout(header_row)

        layout.addWidget(QLabel(
            "<p>Select the applications to install after base system setup:</p>"
        ))

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll_content = QWidget()
        scroll_layout = QVBoxLayout(scroll_content)
        scroll_layout.setSpacing(4)

        for category, apps in SOFTWARE_CATEGORIES.items():
            box = QGroupBox(category)
            box_layout = QVBoxLayout(box)
            box_layout.setSpacing(4)

            chk_list = []
            for pkg, name, default in apps:
                chk = QCheckBox(f"{name}  ({pkg})")
                chk.setChecked(default)
                chk.stateChanged.connect(self._update_pkg_count)
                box_layout.addWidget(chk)
                self.checkboxes[pkg] = chk
                chk_list.append(chk)

            btn_row = QHBoxLayout()
            b_all = QPushButton("Select All")
            b_all.setObjectName("secondaryBtn")
            b_none = QPushButton("Clear")
            b_none.setObjectName("secondaryBtn")
            b_all.clicked.connect(lambda _, cl=chk_list: [c.setChecked(True) for c in cl])
            b_none.clicked.connect(lambda _, cl=chk_list: [c.setChecked(False) for c in cl])
            btn_row.addWidget(b_all)
            btn_row.addWidget(b_none)
            btn_row.addStretch()
            box_layout.addLayout(btn_row)

            scroll_layout.addWidget(box)

        scroll.setWidget(scroll_content)
        layout.addWidget(scroll)
        self._update_pkg_count()
        self.tabs.addTab(tab, "5. Software")

    def _update_pkg_count(self):
        count = sum(1 for chk in self.checkboxes.values() if chk.isChecked())
        self.pkg_count_label.setText(f"{count} packages selected")

    # ── Tab 6: Drivers ──────────────────────────────────────────────────────

    def _setup_drivers_tab(self):
        tab = QWidget()
        layout = QVBoxLayout(tab)

        layout.addWidget(QLabel(
            "<h3>Graphics Drivers & Extras</h3>"
            "<p>Select GPU drivers to install on the target system:</p>"
        ))

        # Auto-detect GPU
        gpu_info = self._detect_gpu()
        if gpu_info:
            detect_label = QLabel(f"<p style='color: #a6e3a1;'>🔍 Detected GPU: <b>{gpu_info}</b></p>")
            detect_label.setWordWrap(True)
            layout.addWidget(detect_label)

        driver_box = QGroupBox("GPU Drivers")
        driver_layout = QVBoxLayout(driver_box)

        self.chk_nvidia = QCheckBox(
            "NVIDIA Open Driver  (nvidia-open, nvidia-utils, nvidia-settings, nvidia-prime)"
        )
        self.chk_nvidia.setChecked("nvidia" in gpu_info.lower() if gpu_info else False)
        driver_layout.addWidget(self.chk_nvidia)

        self.chk_amd = QCheckBox(
            "AMD Radeon  (mesa, vulkan-radeon, xf86-video-amdgpu, libva-mesa-driver)"
        )
        self.chk_amd.setChecked("amd" in gpu_info.lower() if gpu_info else True)
        driver_layout.addWidget(self.chk_amd)

