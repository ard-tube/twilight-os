#!/usr/bin/env bash
# ==============================================================================
# Twilight OS Terminal / TUI Installer
# Production-grade text-based installer with dialog checklist and post-install
# finalizer for Twilight OS.
# ==============================================================================
set -euo pipefail

# Elevate privileges if not running as root
if [[ $EUID -ne 0 ]]; then
    echo "Twilight OS Installer requires root privileges."
    echo "Elevating with sudo..."
    exec sudo "$0" "$@"
fi

# Colors
PURPLE='\033[0;35m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

CONF_FILE="/tmp/twilight-install.conf"

# Initialize default config if not present
init_default_config() {
    if [[ ! -f "$CONF_FILE" ]]; then
        cat > "$CONF_FILE" << 'EOF'
{
  "packages": [],
  "drivers": [],
  "flatpak": true,
  "multilib": true
}
EOF
    fi
}
init_default_config

print_banner() {
    clear
    echo -e "${PURPLE}"
    if [[ -f /usr/share/twilight/ascii-logo.txt ]]; then
        cat /usr/share/twilight/ascii-logo.txt
    else
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║                     TWILIGHT OS                            ║"
        echo "╚════════════════════════════════════════════════════════════╝"
    fi
    echo -e "${NC}"
    echo -e "${CYAN}Welcome to the Twilight OS Terminal Setup Assistant!${NC}"
    echo -e "${BLUE}KDE Plasma 6 • Wayland • Rolling Release${NC}"
    echo "────────────────────────────────────────────────────────────"
}

manage_software_suites() {
    local DIALOG_TOOL=""
    if command -v dialog >/dev/null 2>&1; then
        DIALOG_TOOL="dialog"
    elif command -v whiptail >/dev/null 2>&1; then
        DIALOG_TOOL="whiptail"
    fi

    if [[ -z "$DIALOG_TOOL" ]]; then
        echo -e "${YELLOW}Neither 'dialog' nor 'whiptail' found. Standard minimal install will proceed.${NC}"
        read -rp "Press Enter to return to menu..." _
        return
    fi

    local CHOICES
    CHOICES=$("$DIALOG_TOOL" --title "Twilight OS Software Suites" --checklist \
        "Choose additional software packs to install on target system:" 20 70 8 \
        "OFFICE"  "LibreOffice, Obsidian, Okular, Code" ON \
        "MEDIA"   "VLC, MPV, OBS Studio, GIMP, Audacity" ON \
        "GAMING"  "Steam, Lutris, MangoHud, Wine, Discord" ON \
        "WEB"     "Firefox, Chromium, qBittorrent, Telegram" ON \
        "UTILS"   "Timeshift, GParted, Btop, Flameshot" ON \
        "NVIDIA"  "NVIDIA Open Drivers (nvidia-open)" OFF \
        "AMD"     "AMD Radeon Vulkan & Mesa" ON \
        "INTEL"   "Intel Graphics & Video Acceleration" ON \
        3>&1 1>&2 2>&3) || true

    if [[ -z "$CHOICES" ]]; then
        echo "No software suites selected or selection cancelled."
        read -rp "Press Enter to return to menu..." _
        return
    fi

    # Parse suites into package list
    python3 -c "
import json
suites = '$CHOICES'.replace('\"', '').split()
pkg_map = {
    'OFFICE': ['libreoffice-fresh', 'obsidian', 'okular', 'code'],
    'MEDIA': ['vlc', 'mpv', 'obs-studio', 'gimp', 'audacity'],
    'GAMING': ['steam', 'lutris', 'mangohud', 'gamemode', 'wine', 'discord'],
    'WEB': ['firefox', 'chromium', 'qbittorrent', 'telegram-desktop'],
    'UTILS': ['timeshift', 'gparted', 'btop', 'htop', 'fastfetch', 'flameshot']
}
drv_map = {
    'NVIDIA': 'nvidia',
    'AMD': 'amd',
    'INTEL': 'intel'
}
pkgs = []
drivers = []
for s in suites:
    if s in pkg_map:
        pkgs.extend(pkg_map[s])
    if s in drv_map:
        drivers.append(drv_map[s])

try:
    conf = json.load(open('$CONF_FILE'))
except Exception:
    conf = {}
conf['packages'] = list(dict.fromkeys(pkgs))
conf['drivers'] = list(dict.fromkeys(drivers))
json.dump(conf, open('$CONF_FILE', 'w'), indent=2)
"
    echo -e "${GREEN}✓ Software preferences saved to $CONF_FILE${NC}"
    read -rp "Press Enter to return to menu..." _
}

manage_partitions() {
    echo ""
    echo -e "${CYAN}Available Storage Devices:${NC}"
    lsblk -d -n -o NAME,SIZE,MODEL,TYPE | awk '$4=="disk"'
    echo ""
    read -rp "Enter disk name to partition (e.g., sda or nvme0n1, or press Enter to cancel): " dsk
    if [[ -z "$dsk" ]]; then
        return
    fi

    # Strip /dev/ if user entered it
    dsk="${dsk#/dev/}"

    if [[ ! -b "/dev/$dsk" ]]; then
        echo -e "${RED}Error: /dev/$dsk does not exist or is not a block device.${NC}"
        read -rp "Press Enter to return to menu..." _
        return
    fi

    # Record disk choice in config
    python3 -c "
import json
try:
    conf = json.load(open('$CONF_FILE'))
except Exception:
    conf = {}
conf['disk'] = '/dev/$dsk'
json.dump(conf, open('$CONF_FILE', 'w'), indent=2)
" 2>/dev/null || true

    echo -e "${YELLOW}Launching cfdisk on /dev/$dsk...${NC}"
    cfdisk "/dev/$dsk" || true
    echo -e "${GREEN}Partition changes applied (if saved).${NC}"
    read -rp "Press Enter to return to menu..." _
}

start_guided_installation() {
    echo ""
    echo -e "${GREEN}Starting Twilight OS guided installation via archinstall...${NC}"
    echo "------------------------------------------------------------"

    if ! command -v archinstall >/dev/null 2>&1; then
        echo -e "${RED}Error: archinstall not found in this environment.${NC}"
        read -rp "Press Enter to return to menu..." _
        return
    fi

    # Run archinstall
    archinstall || {
        echo -e "${YELLOW}archinstall exited or was interrupted.${NC}"
        read -rp "Press Enter to return to menu..." _
        return
    }

    # Run Twilight OS Post-Install Finalizer
    echo ""
    echo -e "${CYAN}→ Finalizing Twilight OS customizations on target installation...${NC}"
    if [[ -x /usr/local/bin/twilight-finalize-install ]]; then
        /usr/local/bin/twilight-finalize-install || {
            echo -e "${YELLOW}⚠ Twilight finalizer encountered non-critical warnings.${NC}"
        }
    fi

    echo ""
    echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  🎉 Twilight OS installation is complete!                  ${NC}"
    echo -e "${GREEN}  You can now reboot your machine into Twilight OS.         ${NC}"
    echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
    read -rp "Press Enter to return to menu..." _
}

show_system_info() {
    echo ""
    echo -e "${CYAN}--- Hardware & Environment Info ---${NC}"
    uname -a
    echo ""
    echo -e "${CYAN}--- Memory ---${NC}"
    free -h
    echo ""
    echo -e "${CYAN}--- Storage Disks ---${NC}"
    lsblk -e 7,11 -o NAME,SIZE,FSTYPE,MODEL,MOUNTPOINTS
    echo ""
    read -rp "Press Enter to return to menu..." _
}

# Main event loop (replaces recursive calls)
while true; do
    print_banner

    # Check if packages are configured
    PKG_COUNT=$(python3 -c "import json; conf=json.load(open('$CONF_FILE')); print(len(conf.get('packages', [])))" 2>/dev/null || echo "0")
    if [[ "$PKG_COUNT" -gt 0 ]]; then
        echo -e "${GREEN}Current Selection:${NC} $PKG_COUNT extra packages configured"
        echo "────────────────────────────────────────────────────────────"
    fi

    echo "1) Start Guided Installation (archinstall + Twilight Setup)"
    echo "2) Manage Partitions (cfdisk)"
    echo "3) Software Suite Selection (Office, Gaming, Media, Drivers)"
    echo "4) Launch Graphical Installer (GUI)"
    echo "5) View System & Hardware Info"
    echo "6) Exit to Shell"
    echo "────────────────────────────────────────────────────────────"

    read -rp "Select an option [1-6]: " choice

    case "$choice" in
        1)
            start_guided_installation
            ;;
        2)
            manage_partitions
            ;;
        3)
            manage_software_suites
            ;;
        4)
            if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
                if [[ -x /usr/local/bin/twilight-installer-gui ]]; then
                    exec /usr/local/bin/twilight-installer-gui
                fi
            else
                echo -e "${RED}No graphical display session detected (DISPLAY/WAYLAND_DISPLAY unset).${NC}"
                read -rp "Press Enter to return to menu..." _
            fi
            ;;
        5)
            show_system_info
            ;;
        6)
            echo ""
            echo "Exiting to shell. Type 'twilight-installer' anytime to relaunch."
            exit 0
            ;;
        *)
            echo -e "${RED}Invalid selection '$choice'. Please choose 1-6.${NC}"
            sleep 1
            ;;
    esac
done
