#!/usr/bin/env bash
# ==============================================================================
# Twilight OS Installer — Master Launcher
# Detects environment (Wayland/X11 or console/TTY) and launches the appropriate
# installer (Qt6 GUI or Terminal TUI) with resilient fallback.
# ==============================================================================
set -euo pipefail

# Force CLI if flag is passed
if [[ "${1:-}" == "--cli" || "${1:-}" == "-c" ]]; then
    shift
    TERMINAL=$(command -v konsole || command -v xterm || true)
    if [[ -n "$TERMINAL" ]]; then
        exec "$TERMINAL" -e sudo /usr/local/bin/twilight-installer-cli "$@"
    else
        exec sudo /usr/local/bin/twilight-installer-cli "$@"
    fi
fi

# Ensure Wayland and X11 display environment is preserved
export QT_QPA_PLATFORM="wayland;xcb"

# If graphical session is active, launch GUI directly as the current user
if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
    if /usr/local/bin/twilight-installer-gui "$@"; then
        exit 0
    fi
fi

# Fallback: Launch CLI in a visible terminal emulator window
TERMINAL=$(command -v konsole || command -v xterm || true)
if [[ -n "$TERMINAL" ]]; then
    exec "$TERMINAL" -e sudo /usr/local/bin/twilight-installer-cli "$@"
else
    exec sudo /usr/local/bin/twilight-installer-cli "$@"
fi
