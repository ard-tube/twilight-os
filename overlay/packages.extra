# ==============================================================================
# Twilight OS Extra Packages
# Keep this list LEAN — the live ISO must stay strictly under 2 GB.
# Packages like Firefox, Flatpak, Kate, LibreOffice, Steam, and GPU drivers
# are installed onto the target system via the Twilight Setup Assistant.
# ==============================================================================

# Core KDE Plasma Desktop & Session (Wayland)
plasma-desktop
plasma-workspace
plasma-nm
plasma-pa
kscreen
sddm
systemsettings
polkit-kde-agent
konsole
dolphin
ark

# Twilight Installer & Dependencies
python-pyqt6
dialog
archinstall

# Typography & CJK/Unicode Font
noto-fonts

# Themes, Styles & Icons
breeze
breeze-icons
breeze-gtk

# Wayland Support & XDG Portals
qt6-wayland
xdg-desktop-portal
xdg-desktop-portal-kde

# Disk Management & Filesystems
partitionmanager
dosfstools
e2fsprogs
ntfs-3g

# Graphics — Mesa provides universal Wayland/Gallium display support
mesa

# Audio Backend & PipeWire
pipewire
pipewire-pulse
pipewire-alsa
wireplumber

# Networking
networkmanager

# System Utilities & Monitoring
sudo
nano
fastfetch
htop
